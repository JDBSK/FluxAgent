# FluxAgent 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# ==================== 模型配置 ====================

# 默认模型提供商 (可选：openai, anthropic, aliyun, tencent, z.ai, ollama, other)
DEFAULT_PROVIDER=aliyun

# 默认模型名称
DEFAULT_MODEL=glm-5

# ==================== 上下文裁剪 ====================
# 高/低水位：达到 20 个用户回合时压缩旧内容，保留最近 10 个完整回合。
# 这是可评测的默认基线，不代表对所有模型和任务都最优。
CONTEXT_TRIGGER_TURNS=20
CONTEXT_KEEP_TURNS=10

# ==================== OpenAI 兼容配置 ====================
# 适用于：OpenAI、阿里云、腾讯云、Z.AI 等兼容接口

# API Key (必填，除非使用 Ollama)
OPENAI_API_KEY=sk-your-api-key-here

# Base URL (可选，使用官方接口可留空或注释)
# OpenAI 官方：https://api.openai.com/v1
# 阿里云：https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云 coding: https://coding.dashscope.aliyuncs.com/v1
OPENAI_API_BASE=https://coding.dashscope.aliyuncs.com/v1

# ==================== 能力路由（可选） ====================

# 受约束 LLM 路由重排：BM25 召回 Top-K 候选后由该模型做语义单选。
# 留空时使用启发式重排（词法模式）。建议与 DEFAULT_MODEL 同渠道。
# FLUXAGENT_ROUTER_MODEL=

# 语义向量检索（dense 半边）：需要专门的 embedding 模型（chat 模型不支持
# /embeddings 接口），如阿里云 text-embedding-v4、SiliconFlow BAAI/bge-m3。
# 三项全部配置后自动启用双路 RRF 融合；默认不启用，路由退化为单路 BM25。
# FLUXAGENT_EMBEDDING_BASE_URL=
# FLUXAGENT_EMBEDDING_API_KEY=
# FLUXAGENT_EMBEDDING_MODEL=

# ==================== 入口规划分类器（可选） ====================

# 规则快筛拿不准"要不要显式多步计划"时，用一个小模型做二元分类（只回 JSON
# {"needs_plan":true|false}，不选工具、不碰权限）。默认开启。
# 设为 0/off/false/no 可完全关闭：此时规则判不准就按"不规划"直答。
# FLUXAGENT_PLAN_CLASSIFIER=1
# 留空则使用 DEFAULT_MODEL / DEFAULT_PROVIDER（建议用便宜的快模型）
# FLUXAGENT_PLAN_CLASSIFIER_MODEL=
# FLUXAGENT_PLAN_CLASSIFIER_PROVIDER=

# ==================== Anthropic 配置 ====================
# 仅在 DEFAULT_PROVIDER=anthropic 时使用

# API Key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Base URL (可选，使用代理时配置)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==================== Ollama 配置 ====================
# 仅在 DEFAULT_PROVIDER=ollama 时使用

# Ollama 本地服务地址 (默认：http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
