{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module entry.main (cyber)",
            "type": "debugpy",
            "request": "launch",
            "module": "entry.main",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "G:\\anaconda3\\envs\\cyber\\python.exe",
            "pythonArgs": [
                "-Xfrozen_modules=off"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8",
                "PYTHONUTF8": "1"
            }
        }
    ]
}